# ──────────────────────────────────────────────────────────────
# Variables de entorno para desarrollo local
# Copia este archivo a .env y completa los valores
# ──────────────────────────────────────────────────────────────

# Django
SECRET_KEY=django-insecure-clave-local-solo-desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos local (PostgreSQL)
DB_NAME=sistema_llantero_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# En producción (Render) esta variable es generada automáticamente
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Celery / Redis (opcional en desarrollo)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
